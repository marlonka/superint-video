{
  "name": "superint-video-studio",
  "version": "0.11.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=12.2.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node ../scripts/generate-types.mjs --check",
    "build": "vite build",
    "precheck": "node ../scripts/generate-types.mjs --check",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "types:generate": "node ../scripts/generate-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:api": "node verify-api.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
