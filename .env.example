# Superint Video API keys. Copy to .env and fill in; .env is ignored by git.
# Only the tool reads these values. Check them with `superint-video doctor --online --json` (names only).

# Google AI Studio (default route): Gemini 3.8 Flash TTS, Gemini 3.5 Transcribe, Lyria 3.5.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (alternative route): ElevenLabs v4 Turbo, MAI-Transcribe-2, Lyria 3 Pro.
OPENROUTER_API_KEY=
