  "durationFrames": 900,
  "background": "#0e0f12",
  "tracks": [
    { "id": "scenes", "kind": "visual", "name": "Scenes" },
    { "id": "voice", "kind": "audio", "name": "Voice" },
    { "id": "music", "kind": "audio", "name": "Music" },
    { "id": "sfx", "kind": "audio", "name": "Sound effects" }
  ],
  "clips": [
    {
      "id": "title",
      "type": "scene",
      "src": "scenes/title.html",
